{
  "name": "massoterapia",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestao e agendamento online para clinicas de massoterapia",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @massoterapia/api dev",
    "dev:web": "pnpm --filter @massoterapia/web dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint scripts && turbo run lint",
    "lint:fix": "turbo run lint:fix && eslint scripts --fix",
    "format": "turbo run lint:fix && prettier --write \"**/*.{ts,tsx,js,mjs,cjs,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,jsx,json,md,css,yml,yaml}\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ]
  }
}
