# ------------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL 16 local)
# ------------------------------------------------------------------
# Dev
DATABASE_URL="postgresql://massoterapia:massoterapia_dev@localhost:5432/massoterapia_dev?schema=public"
# Testes (suite roda em serie, nunca em paralelo: ha constraint de exclusao global)
TEST_DATABASE_URL="postgresql://massoterapia:massoterapia_dev@localhost:5432/massoterapia_test?schema=public"

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3333
API_PUBLIC_URL="http://localhost:3333"
WEB_PUBLIC_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------------------------------
# Segredos (TROQUE EM PRODUCAO - minimo 32 caracteres)
# ------------------------------------------------------------------
JWT_ACCESS_SECRET="troque-esta-chave-acesso-min-32-chars-aqui"
JWT_REFRESH_SECRET="troque-esta-chave-refresh-min-32-chars-aqui"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# Criptografia do campo health_encrypted (AES-256-GCM) da anamnese
# 64 chars hex = 32 bytes.   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANAMNESIS_ENCRYPTION_KEY="cole-aqui-64-caracteres-hexadecimais-gerados-aleatoriamente-0000"

# ------------------------------------------------------------------
# Notificacoes
# ------------------------------------------------------------------
NOTIFIER_DRIVER=log
EMAIL_PROVIDER=log
EMAIL_FROM="Massoterapia <nao-responda@localhost>"

# Evolution API (WhatsApp auto-hospedado) - quando NOTIFIER_DRIVER=evolution
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="cole-aqui-a-chave-da-evolution-api"
EVOLUTION_INSTANCE_NAME="massoterapia"

# ------------------------------------------------------------------
# Politicas de negocio (valores default, editaveis por clinica)
# ------------------------------------------------------------------
DEFAULT_APPOINTMENT_MINUTES=60
BOOKING_LEAD_TIME_MINUTES=120
BOOKING_HORIZON_DAYS=60
REMINDER_LEAD_MINUTES=1440
CANCELLATION_MIN_NOTICE_MINUTES=120
CANCELLATION_FEE_PERCENT=0
SLOT_GRANULARITY_MINUTES=15
